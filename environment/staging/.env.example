# Staging environment template
# Copy to environment/staging/.env and fill secrets.

ENVIRONMENT=staging
SECRET_KEY=REPLACE_WITH_40PLUS_CHAR_RANDOM_SECRET
DEBUG=False
ALLOWED_HOSTS=staging.linkme.example,localhost
CSRF_TRUSTED_ORIGINS=https://staging.linkme.example

DATABASE_NAME=linkme_staging
DATABASE_USER=linkme
DATABASE_PASSWORD=REPLACE_ME
DATABASE_HOST=pgbouncer
DATABASE_PORT=6432
DATABASE_CONN_MAX_AGE=0

REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_CELERY_URL=redis://redis:6379/2
REDIS_CHANNELS_URL=redis://redis:6379/3
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_BLOOM_ENABLED=true

JWT_SECRET=REPLACE_WITH_DEDICATED_JWT_SECRET
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
CORS_ALLOWED_ORIGINS=https://staging.linkme.example
SECURE_SSL_REDIRECT=True

FRONTEND_URL=https://staging.linkme.example
DEFAULT_FROM_EMAIL=LinkMe <noreply@staging.linkme.example>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

USE_S3=True
MEDIA_STORAGE_BUCKET=linkme-staging-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
LOG_LEVEL=INFO
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=900

NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=
