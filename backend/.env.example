# =============================================================================
# LinkMe backend environment
# Copy to backend/.env  →  cp backend/.env.example backend/.env
# =============================================================================

# --- Core -------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Staging/production only (comma-separated HTTPS origins):
# CSRF_TRUSTED_ORIGINS=https://linkme.example

# --- Database (PostgreSQL) --------------------------------------------------
DATABASE_NAME=linkme_db
DATABASE_USER=linkme
DATABASE_PASSWORD=linkme_secret
# Docker Compose service name. Use "localhost" when running Django on the host.
DATABASE_HOST=postgres
DATABASE_PORT=5432
# Use 0 when connecting through PgBouncer (staging/production).
DATABASE_CONN_MAX_AGE=60

# --- Redis (cache / Celery / Channels / Bloom) ------------------------------
# Prefer Redis Stack (includes RedisBloom). Local Docker Compose uses redis-stack-server.
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/0
REDIS_CELERY_URL=redis://redis:6379/0
REDIS_CHANNELS_URL=redis://redis:6379/0
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_BLOOM_ENABLED=true

# --- Auth / JWT -------------------------------------------------------------
# Leave empty to fall back to SECRET_KEY.
JWT_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=900
LOGIN_ATTEMPT_WINDOW_SECONDS=900

# --- Google OAuth -----------------------------------------------------------
# Create credentials in Google Cloud Console → APIs & Services → Credentials.
# Authorized JavaScript origins: FRONTEND_URL (e.g. http://localhost:3000)
# Authorized redirect URIs: must match GOOGLE_REDIRECT_URI exactly
#   e.g. http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- WhatsApp OTP (message-service) -----------------------------------------
WHATSAPP_API_URL=https://message-service.dev-link.cloud/messages/send
WHATSAPP_API_KEY=

# --- CORS / frontend --------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# --- Email ------------------------------------------------------------------
# Local default: console backend (prints to runserver logs, does NOT deliver).
# For real delivery (Gmail):
#   1. Enable 2-Step Verification on the Google account
#   2. Create an App Password (Google Account → Security → App passwords)
#   3. Set the values below (do NOT use your normal Gmail password)
#
# DEFAULT_FROM_EMAIL=LinkMe <you@gmail.com>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
#
# Production: prefer SendGrid / Amazon SES / Mailgun / Postmark over Gmail SMTP.
DEFAULT_FROM_EMAIL=LinkMe <noreply@linkme.local>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_VERIFICATION_TOKEN_MAX_AGE=172800
PASSWORD_RESET_TOKEN_MAX_AGE=3600

# --- Object storage / CDN (optional; local FS when USE_S3=False) ------------
USE_S3=False
MEDIA_STORAGE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
# Cloudflare R2 example: https://<accountid>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True

# --- Security (staging/production) ------------------------------------------
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
LOG_LEVEL=INFO
# LOG_DIR=/app/logs

# --- Dev profiling (optional; requires requirements/dev.txt) ----------------
ENABLE_DEBUG_TOOLBAR=False
ENABLE_SILK=False
