# Development environment template
# Copy to backend/.env for local docker compose:
#   cp environment/development/.env.example backend/.env

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
SECRET_KEY=dev-only-change-me-to-a-long-random-string-32chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database ---------------------------------------------------------------
DATABASE_NAME=linkme_db
DATABASE_USER=linkme
DATABASE_PASSWORD=linkme_secret
DATABASE_HOST=postgres
# Inside Docker: 5432. Host-mapped Postgres port is 5435.
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/0
REDIS_CELERY_URL=redis://redis:6379/0
REDIS_CHANNELS_URL=redis://redis:6379/0
REDIS_HOST=
# Inside Docker: 6379. Host-mapped Redis port is 6381.
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_BLOOM_ENABLED=true

# --- Auth / JWT -------------------------------------------------------------
JWT_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
LOGIN_MAX_ATTEMPTS=20
LOGIN_LOCKOUT_SECONDS=300
LOGIN_ATTEMPT_WINDOW_SECONDS=900

# --- Google OAuth -----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8014/auth/google/callback
WHATSAPP_API_URL=https://message-service.dev-link.cloud/messages/send
WHATSAPP_API_KEY=

# --- CORS / frontend --------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8014,http://127.0.0.1:8014
FRONTEND_URL=http://localhost:8014

# --- Email ------------------------------------------------------------------
# Console = logs only. For Gmail inbox delivery use SMTP + App Password:
# DEFAULT_FROM_EMAIL=LinkMe <you@gmail.com>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=LinkMe <noreply@linkme.local>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_VERIFICATION_TOKEN_MAX_AGE=172800
PASSWORD_RESET_TOKEN_MAX_AGE=3600

# --- Object storage ---------------------------------------------------------
USE_S3=False
MEDIA_STORAGE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True

# --- Security ---------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
LOG_LEVEL=DEBUG

# --- Dev profiling ----------------------------------------------------------
ENABLE_DEBUG_TOOLBAR=False
ENABLE_SILK=False
