# Production environment template
# Copy to environment/production/.env — NEVER commit real secrets.

ENVIRONMENT=production
SECRET_KEY=REPLACE_WITH_40PLUS_CHAR_RANDOM_SECRET
DEBUG=False
ALLOWED_HOSTS=linkme.example,www.linkme.example
CSRF_TRUSTED_ORIGINS=https://linkme.example,https://www.linkme.example

DATABASE_NAME=linkme_db
DATABASE_USER=linkme
DATABASE_PASSWORD=REPLACE_ME
DATABASE_HOST=pgbouncer
DATABASE_PORT=6432
DATABASE_CONN_MAX_AGE=0

REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_CELERY_URL=redis://redis:6379/2
REDIS_CHANNELS_URL=redis://redis:6379/3
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_BLOOM_ENABLED=true

JWT_SECRET=REPLACE_WITH_DEDICATED_JWT_SECRET
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
CORS_ALLOWED_ORIGINS=https://linkme.example,https://www.linkme.example
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

FRONTEND_URL=https://linkme.example
DEFAULT_FROM_EMAIL=LinkMe <noreply@linkme.example>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

USE_S3=True
MEDIA_STORAGE_BUCKET=linkme-prod-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
# Cloudflare R2 example:
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=cdn.linkme.example
AWS_QUERYSTRING_AUTH=False

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
LOG_LEVEL=INFO
LOG_DIR=/app/logs

LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=900
LOGIN_ATTEMPT_WINDOW_SECONDS=900

WEB_CONCURRENCY=5
HTTP_PORT=80
HTTPS_PORT=443

NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=wss://linkme.example
